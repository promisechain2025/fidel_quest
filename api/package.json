    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "nodemailer": "^6.9.13",
    "stripe": "^18.0.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
