{
  "name": "egeez-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "eGeez learning-hub API: accounts (JWT) + teacher applications, Tigrinya waitlist, contact. MongoDB when MONGO_URI is set, in-memory otherwise (dev/tests).",
  "main": "index.js",
  "scripts": {
