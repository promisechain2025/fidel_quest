# eGeez hub API - all optional in dev (in-memory store, console "emails").
PORT=8788

# Production database (MongoDB Atlas connection string). Unset = in-memory.
MONGO_URI=

# Auth. Set a long random value in production (unset = random per boot).
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Owner notifications (gmail app-password pattern, same as PROMISECHAIN_BE).
EMAIL_USER=
EMAIL_PASS=
NOTIFY_EMAIL=

# Shared secret for GET /api/admin/* list endpoints.
ADMIN_TOKEN=

# Comma-separated allowed origins for the website (default *).
CORS_ORIGIN=*

# Payments (Stripe Checkout for the Family Pack). All dormant until set.
# In production MONGO_URI is REQUIRED when Stripe is on (orders must persist).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: use a dashboard Price instead of inline price_data.
STRIPE_PRICE_ID=
FAMILY_PACK_PRICE_CENTS=499
# Where Checkout returns to (the deployed website origin).
SITE_URL=
