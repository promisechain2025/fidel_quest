{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::easygeez-com"
    },
    {
      "Sid": "WriteSiteObjectsNotApp",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::easygeez-com/*"
    },
    {
      "Sid": "NeverTouchAppAudioArt",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::easygeez-com/app/*",
        "arn:aws:s3:::easygeez-com/audio/*",
        "arn:aws:s3:::easygeez-com/art/*"
      ]
    },
    {
      "Sid": "NoDeletes",
      "Effect": "Deny",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::easygeez-com/*"
    },
    {
      "Sid": "InvalidateTheSiteDistributionOnly",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::326055865221:distribution/E1SP7A6AIN6IQF"
    }
  ]
}