{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTheSiteBucketOnly",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::REPLACE-BUCKET-NAME"
    },
    {
      "Sid": "ReadWriteObjectsInTheSiteBucket",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:PutObjectAcl"],
      "Resource": "arn:aws:s3:::REPLACE-BUCKET-NAME/*"
    },
    {
      "Sid": "InvalidateThisDistributionOnly",
      "Effect": "Allow",
      "Action": ["cloudfront:CreateInvalidation", "cloudfront:GetInvalidation", "cloudfront:GetDistribution"],
      "Resource": "arn:aws:cloudfront::REPLACE-ACCOUNT-ID:distribution/REPLACE-DISTRIBUTION-ID"
    }
  ]
}
