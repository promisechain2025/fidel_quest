# Build-time defaults for every build (web + native). These are public
# values, safe to commit. Override per-environment with .env.local.

# Apple App Store numeric app id (from App Store Connect). Used for the
# App Store share link on native iOS.
VITE_APPLE_APP_ID=6789703688

# ── Pricing model ──────────────────────────────────────────────────────
# v1.3.0+: PAID UPFRONT. eGeez is sold for $12.99 at download (price set in
# App Store Connect / Play Console), so EVERY build is fully unlocked: no
# trial, no daily free-minutes window, no unlock codes, no Family Pack, no
# in-app purchases, no subscriptions, no Buy/Restore UI.
#
# src/platform/iap.js is kept only as a dormant, fail-closed guard: it does
# nothing unless VITE_STORE_IAP=true AND a RevenueCat key are both set, and
# no purchase UI calls it. Do NOT set VITE_STORE_IAP (or any RevenueCat key)
# for a store release - ios/App/ci_scripts/ci_post_clone.sh fails the
# Xcode Cloud build if VITE_STORE_IAP is set.
