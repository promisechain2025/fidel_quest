# Build-time defaults for every build (web + native). These are public
# values, safe to commit. Override per-environment with .env.local.

# Apple App Store numeric app id (from App Store Connect). Enables the
# in-app Gift flow and is the default buy link for the web trial.
VITE_APPLE_APP_ID=6789703688

# Optional override for the web trial's "Buy the app" button. When unset,
# buyUrl() falls back to the App Store page derived from the id above.
# Set this to a smart link once the Play listing exists too.
# VITE_BUY_URL=

# ── Monetization ───────────────────────────────────────────────────────
# v1.3.0+: PAID UPFRONT. eGeez is sold for $12.99 at download (price set in
# App Store Connect / Play Console), so EVERY build - web, PWA, iOS, Android -
# is fully unlocked: no trial, no daily free-minutes window, no paywall, no
# Buy/Restore UI. The dormant flows stay in the code for a possible v2:
#   - web trial + ask:      VITE_MONETIZE=true
#   - native store IAP:     VITE_STORE_IAP=true plus a RevenueCat key
# Do NOT set either for a store release. RevenueCat keys alone are ignored.
# (1.2's "free download -> 3-day trial -> buy once" + "5 free minutes a day"
# model is switched off here; re-enable by uncommenting.)
# VITE_MONETIZE=true
# VITE_STORE_IAP=true
# VITE_TRIAL_DAYS=3
# VITE_DAILY_PASS_MINUTES=5
# VITE_REVENUECAT_APPLE_KEY=appl_xxxxxxxxxxxxxxxx
# VITE_REVENUECAT_GOOGLE_KEY=goog_xxxxxxxxxxxxxxxx

# One-time price shown in the app (only used by the dormant flows).
VITE_APP_PRICE=$12.99

# Where a Family Pack code is bought. This is the ONLY link the Family Pack
# card uses - it must be a page that actually sells the add-on and mints a
# FAM code (the App Store product page sells the app, not the add-on, so it
# is deliberately never used as a fallback here). Unset it and the card
# falls back to "enter a code" plus a generic explainer.
VITE_FAMILY_PACK_URL=https://easygeez.com/pricing

# One-time Family Pack price shown in the app (default $4.99). Must agree
# with the website and api/routes/pay.js.
# VITE_FAMILY_PACK_PRICE=$4.99
