# Build-time defaults for every build (web + native). These are public
# values, safe to commit. Override per-environment with .env.local.

# Apple App Store numeric app id (from App Store Connect). Enables the
# in-app Gift flow and is the default buy link for the web trial.
VITE_APPLE_APP_ID=6789703688

# Optional override for the web trial's "Buy the app" button. When unset,
# buyUrl() falls back to the App Store page derived from the id above.
# Set this to a smart link once the Play listing exists too.
# VITE_BUY_URL=

# ── Monetization ───────────────────────────────────────────────────────
# Free download, then a 3-day free trial, then the family buys the app once.
# Turning this on enables the trial clock, the once-a-day ask after it ends,
# and the purchase paths (store in-app unlock, or an EGZ code from the site).
# With it OFF the whole app is simply free and no purchase UI exists anywhere.
VITE_MONETIZE=true

# Length of the free trial in days (default 3).
VITE_TRIAL_DAYS=3

# One-time price shown in the app.
VITE_APP_PRICE=$12.99

# STILL REQUIRED for the store builds to actually sell: the RevenueCat public
# key for each platform. Until one is set, a NATIVE build deliberately stays
# free and never nags (it cannot take money, so it must not ask for it).
# The web build sells through the website regardless.
# VITE_REVENUECAT_APPLE_KEY=appl_xxxxxxxxxxxxxxxx
# VITE_REVENUECAT_GOOGLE_KEY=goog_xxxxxxxxxxxxxxxx
